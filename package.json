{
  "name": "prospector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prospector — a movement-engine board game system. Headless rules engine.",
  "scripts": {
    "build:board": "python board/build_board.py",
    "build:content": "python content/build_content.py",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "dev:server": "tsx watch server/main.ts",
    "start:server": "tsx server/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  }
}
